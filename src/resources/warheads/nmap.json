{
  "Nmap - Ghost SYN Sweep": "sudo nmap -sS -T2 -f --data-length 16 --randomize-hosts -Pn 192.168.1.0/24",
  "Nmap - Evasive Ping Sweep": "sudo nmap -sn -PE -PP -PY -PA80,443 -T2 -f --ttl 64 --data-length 16 --randomize-hosts --source-port 53 192.168.1.0/24",
  "Nmap - Full Aggressive": "sudo nmap -A -T4 -p- 192.168.1.0/24",
  "Nmap - Vulnerability Scan": "nmap --script vuln -sV 192.168.1.0/24",
  "Nmap - Web Focus": "nmap -sV -p 80,443,8080,8443 192.168.1.0/24",
  "Nmap - Quick Scan Plus": "sudo nmap -sV -T4 -O -F --version-light 192.168.1.0/24"
}
