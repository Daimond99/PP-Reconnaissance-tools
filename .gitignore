# Logs
logs/

# Docs (keep in git, but ignore generated files)
docs/*.bak
docs/*.orig

# External tool source (cloned, not vendored — each has own .git).
# Anchored to repo root (/tools/) — a bare "tools/" pattern matches any
# directory named "tools" anywhere, which was silently swallowing
# src/tools/hydra/ and src/tools/ncrack/ too.
/tools/

# Wordlists and local test credential lists (large / machine-specific)
rockyou.txt
users_test.txt
pass_test.txt
*.wordlist

# Wizard runtime artifacts (generated by runs, not source)
chain_wizard/**/__pycache__/
chain_wizard/*.log
chain_wizard/*.gnmap
chain_wizard/loot_*.txt
chain_wizard/hydra_*.txt
chain_wizard/smtp_enum.log
